@model IEnumerable<HotelApp_ASP.NET.ViewModels.RoomTypesModel.RoomTypeIndexViewModel>

@{
    ViewData["Title"] = "Типове стаи";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Списък с типове стаи</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Добави нов тип стая
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Име</th>
                            <th>Капацитет</th>
                            <th>Кратко описание</th>
                            <th class="text-end">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var roomType in Model)
                        {
                            <tr>
                                <td><strong>@roomType.Name</strong></td>
                                <td>
                                    <span class="badge bg-secondary">@roomType.Capacity госта</span>
                                </td>
                                <td>@(string.IsNullOrEmpty(roomType.ShortDescription) ? "Няма описание" : roomType.ShortDescription)</td>
                                <td class="text-end">
                                    <div class="btn-group" role="group">
                                        <a asp-action="Details" asp-route-id="@roomType.Id" class="btn btn-info btn-sm text-white" title="Детайли">
                                            <i class="bi bi-eye"></i> Детайли
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@roomType.Id" class="btn btn-warning btn-sm" title="Редактирай">
                                            <i class="bi bi-pencil"></i> Редактирай
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@roomType.Id" class="btn btn-danger btn-sm" title="Изтрий">
                                            <i class="bi bi-trash"></i> Изтрий
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Няма регистрирани типове стаи в системата.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>