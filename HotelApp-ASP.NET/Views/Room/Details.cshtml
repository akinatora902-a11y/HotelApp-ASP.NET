@model HotelApp_ASP.NET.ViewModels.RoomsModels.RoomDetailsViewModel

@{
    ViewData["Title"] = "Room Details";
}

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h3 class="mb-0">Room No. @Model.RoomNumber</h3>
            @if (Model.IsAvailable)
            {
                <span class="badge bg-success fs-6">Available</span>
            }
            else
            {
                <span class="badge bg-danger fs-6">Occupied</span>
            }
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-4">
                    <strong>Room Type:</strong>
                    <p class="text-muted">@Model.RoomTypeName</p>
                </div>
                <div class="col-md-4">
                    <strong>Floor:</strong>
                    <p class="text-muted">@Model.Floor</p>
                </div>
                <div class="col-md-4">
                    <strong>Capacity:</strong>
                    <p class="text-muted">@Model.Capacity guests</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-12">
                    <strong>Description:</strong>
                    <p class="text-muted">@(string.IsNullOrEmpty(Model.Description) ? "No description provided for this room." : Model.Description)</p>
                </div>
            </div>

            <hr />

            <div class="row align-items-center">
                <div class="col-md-6">
                    <h4 class="text-success mb-0">
                        <strong>Price per night:</strong> @Model.PricePerNight.ToString("C2")
                    </h4>
                </div>
            </div>
        </div>
        <div class="card-footer text-end">
            <a asp-action="Index" class="btn btn-secondary me-2">
                <i class="bi bi-arrow-left"></i> Back to List
            </a>