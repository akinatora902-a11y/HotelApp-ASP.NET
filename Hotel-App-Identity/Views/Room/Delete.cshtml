@model HotelApp_ASP.NET.ViewModels.RoomsModels.RoomDetailsViewModel

@{
    ViewData["Title"] = "Delete Room";
}

<div class="container mt-4">
    <div class="card shadow border-danger">
        <div class="card-header bg-danger text-white">
            <h3 class="mb-0">Delete Room</h3>
        </div>
        <div class="card-body">
            <div class="alert alert-warning" role="alert">
                <strong>Warning!</strong> Are you sure you want to delete this room? This action cannot be undone.
            </div>

            <dl class="row mb-4">
                <dt class="col-sm-3">Room Number:</dt>
                <dd class="col-sm-9">@Model.RoomNumber</dd>

                <dt class="col-sm-3">Floor:</dt>
                <dd class="col-sm-9">@Model.Floor</dd>

                <dt class="col-sm-3">Room Type:</dt>
                <dd class="col-sm-9">@Model.RoomTypeName</dd>

                <dt class="col-sm-3">Price per Night:</dt>
                <dd class="col-sm-9">$@Model.PricePerNight.ToString("F2")</dd>

                <dt class="col-sm-3">Availability:</dt>
                <dd class="col-sm-9">
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success">Available</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Occupied / Unavailable</span>
                    }
                </dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="RoomNumber" />
                <input type="hidden" asp-for="Floor" />
                <input type="hidden" asp-for="RoomTypeName" />
                <input type="hidden" asp-for="PricePerNight" />
                <input type="hidden" asp-for="IsAvailable" />

                <div class="d-flex justify-content-between">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Back to List
                    </a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}